# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooat-bin
_pkgname=ooat
pkgver=0.2.0
pkgrel=1
pkgdesc="Single-run scheduled command coordinator backed by transient systemd timer units."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooat"
license=('Apache-2.0')
depends=('glibc')
provides=('ooat')
conflicts=('ooat')
source_x86_64=("${url}/releases/download/v${pkgver}/ooat-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooat-linux-x86_64" "${pkgdir}/usr/bin/ooat"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooat-uninstall"
}
