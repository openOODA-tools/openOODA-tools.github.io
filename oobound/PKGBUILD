# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oobound-bin
_pkgname=oobound
pkgver=0.2.0
pkgrel=1
pkgdesc="Dynamic memory, CPU cycle, and file descriptor clamp for unvetted subprocesses."
arch=('x86_64')
url="https://github.com/openOODA-tools/oobound"
license=('Apache-2.0')
depends=('glibc')
provides=('oobound')
conflicts=('oobound')
source_x86_64=("${url}/releases/download/v${pkgver}/oobound-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oobound-linux-x86_64" "${pkgdir}/usr/bin/oobound"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oobound-uninstall"
}
