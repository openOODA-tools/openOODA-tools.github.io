# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oocmp-bin
_pkgname=oocmp
pkgver=0.2.0
pkgrel=1
pkgdesc="Instant byte-by-byte file comparison reporting first byte difference and line count."
arch=('x86_64')
url="https://github.com/openOODA-tools/oocmp"
license=('Apache-2.0')
depends=('glibc')
provides=('oocmp')
conflicts=('oocmp')
source_x86_64=("${url}/releases/download/v${pkgver}/oocmp-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oocmp-linux-x86_64" "${pkgdir}/usr/bin/oocmp"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oocmp-uninstall"
}
