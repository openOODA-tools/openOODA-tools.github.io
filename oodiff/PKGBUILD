# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oodiff-bin
_pkgname=oodiff
pkgver=0.3.1
pkgrel=1
pkgdesc="Capability-bounded file and directory diff engine with GNU diff parity and MCP surface"
arch=('x86_64')
url="https://github.com/openOODA-tools/oodiff"
license=('Apache-2.0')
depends=('glibc')
provides=('oodiff')
conflicts=('oodiff')
source_x86_64=("${url}/releases/download/v${pkgver}/oodiff-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oodiff-linux-x86_64" "${pkgdir}/usr/bin/oodiff"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oodiff-uninstall"
}
