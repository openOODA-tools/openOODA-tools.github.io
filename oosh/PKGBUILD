# Maintainer: openOODA Team <team@openooda.org>
pkgname=oosh-bin
pkgver=1.0.1
pkgrel=1
pkgdesc="openOODA Sovereign Shell - Intent-Driven Capability-Bounded Shell"
arch=('x86_64')
url="https://github.com/openOODA-tools/oosh"
license=('Apache-2.0')
depends=('glibc')
provides=('oosh')
conflicts=('oosh')
install='oosh.install'
source=("https://github.com/openOODA-tools/oosh/releases/download/v${pkgver}/oosh-linux-x86_64"
        "oosh.install"
        "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/oosh/v${pkgver}/uninstall.sh")
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 "${srcdir}/oosh-linux-x86_64" "${pkgdir}/usr/bin/oosh"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oosh-uninstall"
}
