# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ootar-bin
_pkgname=ootar
pkgver=0.1.0
pkgrel=1
pkgdesc="Traversal-resistant archive manager with zero zip-slip vulnerability and MCP surface"
arch=('x86_64')
url="https://github.com/openOODA-tools/ootar"
license=('Apache-2.0')
depends=('glibc')
provides=('ootar')
conflicts=('ootar')
source_x86_64=("${url}/releases/download/v${pkgver}/ootar-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ootar-linux-x86_64" "${pkgdir}/usr/bin/ootar"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ootar-uninstall"
}
